generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Listing {
  id     Int    @id @default(autoincrement())
  source String?
  category String?
  company String?
  sourceId String @unique
  role String?
  active Boolean?
  terms String[]
  dateUpdated DateTime?
  datePosted DateTime?
  url String?
  locations String[]
  companyUrl String?
  isVisible Boolean @default(true)
  sponsorship String?
  degrees String[]
}

model Application {
  id      Int    @id @default(autoincrement())
  source  String?
  company String?
  sourceId String?
  role    String?
  status  String @default("Applied")
  userId String
  category String?
  terms String[]
  dateApplied DateTime? @default(now())
  datePosted DateTime?
  url String?
  locations String[]
  companyUrl String?
  sponsorship String?
  degrees String[]
  salary String?
}